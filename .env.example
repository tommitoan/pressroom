# Required: shared secret that callers send as "Authorization: Bearer <token>".
# At least 16 characters. Generate one with: openssl rand -hex 32
PRESSROOM_TOKEN=<TOKEN>

# Optional
PORT=8080
LOG_LEVEL=info             # debug, info, warn or error
MAX_BODY_BYTES=2097152     # request body limit, 1024 to 67108864
RENDER_TIMEOUT=20s         # 1s to 2m
CHROME_PATH=
CHROMIUM_NO_SANDBOX=false
RENDER_CONCURRENCY=2
RENDER_QUEUE=4